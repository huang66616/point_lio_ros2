index 0000000..f3ffcb9
--- /dev/null
+++ b/rosbag2_transport/src/rosbag2_transport/verified_play.cpp
@@ -0,0 +1,232 @@
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <atomic>
+#include <cmath>
+#include <cstdlib>
+#include <exception>
+#include <iomanip>
+#include <iostream>
+#include <memory>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "rclcpp/rclcpp.hpp"
+#include "rosbag2_transport/player.hpp"
+#include "rosbag2_transport/reader_writer_factory.hpp"
+
+namespace
+{
+std::string quote(const std::string & value)
+{
+  std::ostringstream out;
+  out << '"';
+  for (unsigned char c : value) {
+    switch (c) {
+      case '"': out << "\\\""; break;
+      case '\\': out << "\\\\"; break;
+      case '\n': out << "\\n"; break;
+      case '\r': out << "\\r"; break;
+      case '\t': out << "\\t"; break;
+      default:
+        if (c < 0x20) {
+          out << "\\u" << std::hex << std::setw(4) << std::setfill('0')
+              << static_cast<unsigned int>(c) << std::dec;
+        } else {
+          out << static_cast<char>(c);
+        }
+    }
+  }
+  out << '"';
+  return out.str();
+}
+
+struct Args
+{
+  std::string bag;
+  std::string run_id;
+  std::string fingerprint;
+  std::string evidence_path;
+  double rate = 1.0;
+  double start_offset = 0.0;
+  std::vector<std::string> topics;
+};
+
+Args parse(int argc, char ** argv)
+{
+  Args result;
+  for (int i = 1; i < argc; ++i) {
+    const std::string key = argv[i];
+    if (key == "--loop" || key == "--seek" || key == "--start-paused") {
+      throw std::invalid_argument("unsupported playback control: " + key);
+    }
+    if (i + 1 >= argc) {
+      throw std::invalid_argument("missing value for " + key);
+    }
+    const std::string value = argv[++i];
+    if (key == "--bag") {result.bag = value;}
+    else if (key == "--run-id") {result.run_id = value;}
+    else if (key == "--fingerprint") {result.fingerprint = value;}
+    else if (key == "--evidence") {result.evidence_path = value;}
+    else if (key == "--topic") {result.topics.push_back(value);}
+    else if (key == "--rate") {result.rate = std::stod(value);}
+    else if (key == "--start-offset") {result.start_offset = std::stod(value);}
+    else {throw std::invalid_argument("unknown option: " + key);}
+  }
+  if (result.bag.empty() || result.run_id.empty() ||
+    result.fingerprint.empty() || result.evidence_path.empty() ||
+    !std::isfinite(result.rate) || result.rate <= 0.0 ||
+    !std::isfinite(result.start_offset) || result.start_offset < 0.0)
+  {
+    throw std::invalid_argument("missing or invalid required argument");
+  }
+  return result;
+}
+
+void write_exclusive(const std::string & path, const std::string & data)
+{
+  const int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0644);
+  if (fd < 0) {throw std::runtime_error("cannot create evidence file");}
+  const char * pointer = data.data();
+  size_t remaining = data.size();
+  while (remaining != 0) {
+    const ssize_t count = write(fd, pointer, remaining);
+    if (count <= 0) {
+      close(fd);
+      throw std::runtime_error("cannot write evidence file");
+    }
+    pointer += count;
+    remaining -= static_cast<size_t>(count);
+  }
+  if (fsync(fd) != 0) {
+    close(fd);
+    throw std::runtime_error("cannot sync evidence file");
+  }
+  close(fd);
+}
+
+std::string make_evidence(
+  const Args & args, const rosbag2_transport::PlaybackEvidence & state,
+  const std::string & outcome)
+{
+  std::ostringstream out;
+  out << "{\n\"schema_version\":1,\"run_id\":" << quote(args.run_id)
+      << ",\"bag_path\":" << quote(args.bag)
+      << ",\"bag_fingerprint\":" << quote(args.fingerprint)
+      << ",\"rate\":" << std::setprecision(17) << args.rate
+      << ",\"start_offset\":" << args.start_offset << ",\"loop\":false"
+      << ",\"topics\":[";
+  for (size_t i = 0; i < args.topics.size(); ++i) {
+    if (i != 0) {out << ',';}
+    out << quote(args.topics[i]);
+  }
+  out << "],\"reader_eof\":" << (state.reader_eof ? "true" : "false")
+      << ",\"reader_thread_finished\":" << (state.reader_thread_finished ? "true" : "false")
+      << ",\"queue_drained\":" << (state.queue_drained ? "true" : "false")
+      << ",\"interrupted\":" << (state.interrupted ? "true" : "false")
+      << ",\"runtime_error\":" << (state.runtime_error ? "true" : "false")
+      << ",\"read_count\":" << state.read_count
+      << ",\"enqueue_success\":" << state.enqueue_success
+      << ",\"enqueue_failure\":" << state.enqueue_failure
+      << ",\"pop_success\":" << state.pop_success
+      << ",\"pop_failure\":" << state.pop_failure
+      << ",\"publish_success\":" << state.publish_success
+      << ",\"publish_failure\":" << state.publish_failure
+      << ",\"control_changes\":" << state.control_changes
+      << ",\"errors\":[";
+  for (size_t i = 0; i < state.errors.size(); ++i) {
+    if (i != 0) {out << ',';}
+    out << quote(state.errors[i]);
+  }
+  out << "],\"internal_result\":" << quote(outcome) << "}\n";
+  return out.str();
+}
+}  // namespace
+
+int main(int argc, char ** argv)
+{
+  try {
+    const Args args = parse(argc, argv);
+    rclcpp::init(0, nullptr);
+    rosbag2_storage::StorageOptions storage;
+    storage.uri = args.bag;
+    rosbag2_transport::PlayOptions options;
+    options.rate = args.rate;
+    options.start_offset = static_cast<rcutils_time_point_value_t>(args.start_offset * 1e9);
+    options.topics_to_filter = args.topics;
+    options.disable_keyboard_controls = true;
+    options.loop = false;
+    auto reader = rosbag2_transport::ReaderWriterFactory::make_reader(storage);
+    auto player = std::make_shared<rosbag2_transport::Player>(
+      std::move(reader), storage, options, "verified_rosbag2_player");
+    const char * test_fault = std::getenv("ROSBAG_EVIDENCE_TEST_FAULT");
+    const bool race_interrupt = test_fault != nullptr &&
+      std::string(test_fault) == "race_interrupt";
+    std::atomic_bool stop_race_thread{false};
+    std::thread race_thread;
+    if (race_interrupt) {
+      race_thread = std::thread([&]() {
+        while (!stop_race_thread.load()) {
+          if (player->completion_evidence().reader_eof) {
+            player->mark_interrupted();
+            return;
+          }
+          std::this_thread::sleep_for(std::chrono::microseconds(100));
+        }
+      });
+    }
+    std::weak_ptr<rosbag2_transport::Player> weak_player = player;
+    rclcpp::on_shutdown([weak_player]() {
+      if (auto locked = weak_player.lock()) {locked->mark_interrupted();}
+    });
+    rclcpp::executors::SingleThreadedExecutor executor;
+    executor.add_node(player);
+    std::exception_ptr spin_error;
+    std::thread spin_thread([&]() {
+      try {executor.spin();}
+      catch (...) {spin_error = std::current_exception();}
+    });
+    std::string top_error;
+    try {player->play();}
+    catch (const std::exception & e) {top_error = e.what();}
+    catch (...) {top_error = "unknown playback exception";}
+    executor.cancel();
+    spin_thread.join();
+    stop_race_thread.store(true);
+    if (race_thread.joinable()) {race_thread.join();}
+    if (spin_error) {
+      try {std::rethrow_exception(spin_error);}
+      catch (const std::exception & e) {top_error += std::string(" executor: ") + e.what();}
+      catch (...) {top_error += " executor: unknown exception";}
+    }
+    const auto state = player->completion_evidence();
+    const bool counts_ok = state.read_count > 0 &&
+      state.read_count == state.enqueue_success &&
+      state.enqueue_success == state.pop_success &&
+      state.pop_success == state.publish_success &&
+      state.enqueue_failure == 0 && state.pop_failure == 0 &&
+      state.publish_failure == 0;
+    const std::string result =
+      state.interrupted ? "interrupted" :
+      (state.runtime_error || !top_error.empty()) ? "error" :
+      (state.reader_eof && state.reader_thread_finished && !state.queue_drained) ?
+      "reader_eof_queue_pending" :
+      (state.reader_eof && state.reader_thread_finished && state.queue_drained &&
+      counts_ok && state.control_changes == 0 && state.errors.empty() && rclcpp::ok()) ?
+      "natural_end" : "unknown";
+    auto output_state = state;
+    if (!top_error.empty()) {output_state.errors.push_back(top_error);}
+    write_exclusive(args.evidence_path, make_evidence(args, output_state, result));
+    std::cout << "ROSBAG_EVIDENCE_RESULT " << result << std::endl;
+    rclcpp::shutdown();
+    return result == "natural_end" ? 0 : 2;
+  } catch (const std::exception & e) {
+    std::cerr << "verified_play error: " << e.what() << std::endl;
+    if (rclcpp::ok()) {rclcpp::shutdown();}
+    return 3;
+  }
+}
